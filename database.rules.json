{
  "rules": {
    ".read": false,
    ".write": false,

    "accessories": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },

    "message": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },

    "admins": {
      ".read": false,
      ".write": false
    }
  }
}
